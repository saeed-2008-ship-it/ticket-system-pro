<script>
async function load(){
  const token = localStorage.getItem('token');

  const res = await fetch('https://ticket-system-pro.onrender.com/tickets',{
    headers:{
      Authorization: `Bearer ${token}`
    }
  });

  const data = await res.json();

  t.innerHTML = data.map(x=>
    `<tr>
      <td>${x.id}</td>
      <td>${x.title}</td>
      <td>${x.status}</td>
      <td>
        <button onclick="update(${x.id},'Closed')">Close</button>
      </td>
    </tr>`
  ).join('');
}

async function update(id,status){
  const token = localStorage.getItem('token');

  await fetch('https://ticket-system-pro.onrender.com/tickets/'+id,{
    method:'PUT',
    headers:{
      'Content-Type':'application/json',
      Authorization: `Bearer ${token}`
    },
    body:JSON.stringify({status})
  });

  load();
}
</script>
